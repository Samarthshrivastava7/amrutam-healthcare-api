DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional production hardening (comma-separated hostnames, no scheme/port)
TRUSTED_HOSTS=
HTTPS_REDIRECT=false
# Optional comma-separated CORS origins; leave empty when no browser frontend calls the API
CORS_ORIGINS=
# Set a long random secret to enable the protected /metrics endpoint; leave empty to disable it
METRICS_BEARER_TOKEN=
